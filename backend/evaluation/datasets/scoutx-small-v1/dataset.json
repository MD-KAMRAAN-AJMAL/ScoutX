      "content": "class CacheLease:\n    def invalidate_after_write(self, key: str) -> None:\n        \"\"\"Remove the stale cache value after a successful write.\"\"\"\n        self.store.pop(key, None)\n\n# TTL defaults to 900 seconds; eviction is least-recently-used.",
      "metadata": {
        "project": "aurora"
      }
