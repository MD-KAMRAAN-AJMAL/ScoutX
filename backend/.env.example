APP_NAME=ScoutX API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://scoutx:replace-with-a-local-password@localhost:5432/scoutx
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=file_content_chunks
QDRANT_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
SCOUTX_API_LOCAL_ONLY=true
# Only set this for a local reverse proxy you control. Docker Compose configures its exact proxy address.
SCOUTX_TRUSTED_PROXY_IPS=
SCOUTX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCOUTX_MAX_REQUEST_BODY_BYTES=1048576
SCOUTX_PARSER_MAX_FILE_BYTES=536870912
SCOUTX_PARSER_TIMEOUT_SECONDS=300
SCOUTX_WORKER_CONCURRENCY=2
SCOUTX_WORKER_TASK_SOFT_LIMIT_SECONDS=3300
SCOUTX_WORKER_TASK_HARD_LIMIT_SECONDS=3600
SCOUTX_OTEL_ENABLED=false
# Optional OTLP/HTTP collector base URL, for example http://127.0.0.1:4318
# SCOUTX_OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4318
SCOUTX_EMBEDDING_DEVICE=auto
SCOUTX_EMBEDDING_CPU_THREADS=4
SCOUTX_EMBEDDING_BATCH_SIZE=32
SCOUTX_RERANKER_ENABLED=true
SCOUTX_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
SCOUTX_RERANKER_LOCAL_FILES_ONLY=false
SCOUTX_RERANKER_CANDIDATE_LIMIT=50
SCOUTX_RERANKER_TOP_N=20
SCOUTX_RERANKER_BATCH_SIZE=8
SCOUTX_RERANKER_MAX_LENGTH=2048
SCOUTX_RERANKER_FALLBACK_ENABLED=true
SCOUTX_RAG_CONTEXT_TOKEN_BUDGET=6000
SCOUTX_RAG_MIN_CONFIDENCE=0.08
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
EXCLUDED_PATHS=[]
