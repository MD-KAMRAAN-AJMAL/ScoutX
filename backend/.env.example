APP_NAME=ScoutX API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://scoutx@localhost:5432/scoutx
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=file_content_chunks
REDIS_URL=redis://localhost:6379/0
SCOUTX_EMBEDDING_DEVICE=auto
SCOUTX_EMBEDDING_CPU_THREADS=4
SCOUTX_EMBEDDING_BATCH_SIZE=32
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
EXCLUDED_PATHS=[]
