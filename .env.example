# Copy to .env. Replace this with a random URL-safe value before starting.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=scoutx
POSTGRES_USER=scoutx

POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379
OLLAMA_PORT=11434
API_PORT=8000
FRONTEND_PORT=5173

QDRANT_COLLECTION=file_content_chunks
QDRANT_TIMEOUT_SECONDS=5
SCOUTX_OLLAMA_MODEL=qwen3:8b
SCOUTX_EMBEDDING_DEVICE=auto
SCOUTX_EMBEDDING_CPU_THREADS=4
SCOUTX_EMBEDDING_BATCH_SIZE=32
SCOUTX_RERANKER_ENABLED=false
SCOUTX_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
SCOUTX_RERANKER_LOCAL_FILES_ONLY=false
SCOUTX_RERANKER_FALLBACK_ENABLED=true
SCOUTX_WORKER_CONCURRENCY=1

# Host directory explicitly mounted read-only at /demo/sample-files in app containers.
SCOUTX_DEMO_ROOT=./demo/sample-files
